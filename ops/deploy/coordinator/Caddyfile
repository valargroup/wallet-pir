# Rendered during Enhance coordinator deploys: ENHANCE_PUBLIC_HOST is replaced with
# the host of ENHANCE_PUBLIC_URL before the file is validated and installed.
# (deploy-enhance-pir.sh, which used to do this, was removed in afdb4b6d.)
ENHANCE_PUBLIC_HOST {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
		}
	}

	# Operator-only surfaces stay on loopback; the pir-apm sidecar scrapes
	# them locally.
	handle /metrics {
		respond 404
	}
	handle /ready {
		respond 404
	}
	# Opt-in archive parent filters; only verified public artifacts live here.
	handle_path /v1/filters/parents/* {
		root * /srv/transparent-parent-filters/public
		header Cache-Control "public, max-age=300"
		file_server
	}
	# Continuous transparent publication: both origins read this authority.
	# The map, init and manifests come from the transparent publisher. This
	# block must stay in the rendered file: the transparent router proxies its
	# public metadata here, and without it every wallet-facing metadata path
	# falls through to Enhance and returns 404. The publisher's activation
	# recognises this comment and leaves the block as it is.
	@transparent_publication path /v1/shards /v1/shards/init /v1/shards/*/revisions/*/manifest /v1/filters/shards /v1/filters/shards/*
	handle @transparent_publication {
		reverse_proxy 127.0.0.1:8094
	}
	# Public transparent activity filters. Only the wallet-facing paths are
	# routed: the filter service's own /metrics, /ready and /v1/health are not
	# under this prefix and stay unreachable from the internet. Requests here
	# carry chain range information only.
	@legacy_transparent_filters path /v1/filters/*
	handle @legacy_transparent_filters {
		reverse_proxy 127.0.0.1:8090
	}
	# Unauthenticated, aggregate-only dashboard served by the pir-apm sidecar.
	handle_path /apm* {
		reverse_proxy 127.0.0.1:3002
	}
	# Query admission can reject overload before evaluation. Use a fresh local
	# upstream connection so a stale keepalive socket cannot turn that response
	# into a public 502.
	handle /v1/enhance/query {
		reverse_proxy 127.0.0.1:8080 {
			transport http {
				keepalive off
			}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8080
	}
}
