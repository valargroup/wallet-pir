[Unit]
Description=Authenticated transparent worker control sessions
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/transparent-publisher
ExecStart=/usr/bin/python3 /opt/transparent-publisher/transparent-live-fleet.py /opt/transparent-publisher/fleet.json --control-sessions
Restart=on-failure
RestartSec=1
UMask=0077
MemoryMax=128M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/transparent-publisher/state
ReadOnlyPaths=/opt/transparent-publisher/credentials

[Install]
WantedBy=multi-user.target
