[Unit]
Description=Zcash transparent activity filter service (BIP 158)
After=network-online.target zakurad.service
Wants=network-online.target
Requires=zakurad.service

[Service]
Type=simple
# Loopback only. This service has no public route: the wallet-facing API is not
# designed yet, and nothing should be reachable from the internet until it is.
# --shard-dir adds the public half of the published shard set: the map and
# each shard's range filter. A wallet needs those before it can decide which
# shards are worth a private query.
#
# The private retrieval service serves the same bytes at the same paths on its
# own host. That is a relaxation of the earlier rule that kept public bytes off
# the retrieval origin entirely; what it preserves is a wallet's ability to
# fetch the two over *different network paths*, which is why this copy stays.
#
# **This directory and the retrieval worker's must hold the same set.** Both
# hosts publish the map at /v1/filters/shards, so a wallet that took the map
# from here and queried there would be naming shard revisions the worker does
# not hold. The two move together or not at all.
#
# It is also schema-pinned: this binary deserializes shards.json into the
# ShardMap it was compiled against, and a set published under another schema
# is a startup failure -- inside the Enhance coordinated rollout, which will
# roll the whole thing back. Repoint this in the same change that ships a
# binary of the new schema, never after it.
ExecStart=/usr/local/bin/transparent-filter-server --listen 127.0.0.1:8090 --zakura-rpc-url http://127.0.0.1:8232 --zakura-cookie /root/.cache/zakura/.cookie --data-dir /srv/zakura/transparent-filter-data --start-height 3428143 --shard-dir /srv/zakura/transparent-shards-v7
Restart=on-failure
RestartSec=10
User=root
LimitNOFILE=1048576
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
