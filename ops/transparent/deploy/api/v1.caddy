# Wallet API v1 (the v11 history fleet and the txid-2k display site) was
# retired on 2026-10-13. Wallets on an older client get an explicit answer
# instead of a bare 404.
handle /v1/* {
	header Content-Type application/json
	respond `{"error":"api_version_retired","retired":"/v1","use":"/v2"}` 410
}
