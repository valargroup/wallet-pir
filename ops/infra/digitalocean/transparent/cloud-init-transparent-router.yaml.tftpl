#cloud-config
package_update: true
packages: ${packages}
%{ if deploy_public_key != "" ~}
# The deploy workflow authenticates as root with the fleet key, the same key
# the workers accept, so the router is deployable the moment it boots.
ssh_authorized_keys:
  - ${deploy_public_key}
%{ endif ~}
write_files:
  # Unattended upgrades must not restart production services: a libc upgrade
  # made needrestart restart the Status roles on 2026-09-28. Restart on deploy.
  - path: /etc/needrestart/conf.d/90-wallet-pir-no-auto-restart.conf
    permissions: "0644"
    content: |
      $nrconf{restart} = 'l';
  # The daily unattended-upgrade must not bounce the edge; deploys reload it.
  - path: /etc/needrestart/conf.d/transparent-pir.conf
    content: |
      $nrconf{override_rc}{qr(^caddy\.service$)} = 0;
runcmd:
  # Where the deploy stages a rendered Caddyfile and keeps the one it replaced.
  - mkdir -p /opt/transparent-pir/staging /opt/transparent-pir/rollback
