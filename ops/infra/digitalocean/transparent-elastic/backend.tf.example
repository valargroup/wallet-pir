# Remote state on DigitalOcean Spaces. The bucket already holds the production
# state; this root uses its own key in it. Copy to backend.tf and run
# `terraform init` with the Spaces key pair exported as AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY (see README.md). Never point it at production's key.
terraform {
  backend "s3" {
    # Spaces did not enforce conditional S3 lock writes in the rollout test.
    # Every writer must hold /run/lock/transparent-elastic-terraform.lock on the coordinator.
    use_lockfile                = false
    bucket                      = "enhance-pir-terraform"
    key                         = "transparent-elastic/terraform.tfstate"
    region                      = "us-east-1" # ignored by Spaces, required by the backend
    endpoints                   = { s3 = "https://ams3.digitaloceanspaces.com" }
    skip_credentials_validation = true
    skip_region_validation      = true
    skip_requesting_account_id  = true
    skip_metadata_api_check     = true
    skip_s3_checksum            = true
    use_path_style              = false
  }
}
