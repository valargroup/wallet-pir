#cloud-config
package_update: true
packages: ${packages}
%{ if deploy_public_key != "" ~}
# The deploy workflow authenticates as root with the fleet key. Installing it
# here rather than by hand is what makes a rebuilt worker deployable without a
# manual step; the Enhance hosts were done by hand and a new droplet would
# otherwise refuse the deploy.
ssh_authorized_keys:
  - ${deploy_public_key}
%{ endif ~}
%{ if host_key != null ~}
# Elastic members only: the host key the actuator generated and pinned before
# this droplet existed, so the first connection is verified, never trusted on
# first use. Bootstrap rotates it.
ssh_deletekeys: true
ssh_keys:
  ed25519_private: ${jsonencode(host_key.private)}
  ed25519_public: ${jsonencode(host_key.public)}
%{ endif ~}
write_files:
  # Unattended upgrades must not restart production services: a libc upgrade
  # made needrestart restart the Status roles on 2026-09-28. Restart on deploy.
  - path: /etc/needrestart/conf.d/90-wallet-pir-no-auto-restart.conf
    permissions: "0644"
    content: |
      $nrconf{restart} = 'l';
  # An automatic package upgrade must not restart the shard service, which
  # takes minutes to load and loses its warm cache, or the edge. The daily
  # unattended-upgrade did exactly that to the pilot on 2026-09-08; deploys
  # are what restart these units.
  - path: /etc/needrestart/conf.d/transparent-pir.conf
    content: |
      $nrconf{override_rc}{qr(^transparent-shard-server\.service$)} = 0;
      $nrconf{override_rc}{qr(^caddy\.service$)} = 0;
runcmd:
  - mkdir -p /srv/transparent-pir/shards
