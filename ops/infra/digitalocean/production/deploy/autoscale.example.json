{
  "enabled": false,
  "runtime_env_aliases": {
    "TF_VAR_digitalocean_token": "DO_TOKEN_NEW_ORG",
    "TF_VAR_cloudflare_api_token": "CF_API_TOKEN",
    "AWS_ACCESS_KEY_ID": "DO_SPACES_KEY",
    "AWS_SECRET_ACCESS_KEY": "DO_SPACES_SECRET"
  },
  "state_dir": "/srv/enhance-pir/autoscale",
  "control_socket": "/run/enhance-pir/control.sock",
  "lock_file": "/run/lock/enhance-production.lock",
  "coordinator_url": "http://127.0.0.1:8080",
  "zakura_rpc_url": "http://127.0.0.1:8232",
  "zakura_cookie": "/root/.cache/zakura/.cookie",
  "public_url": "https://enhance-pir.valargroup.dev",
  "terraform_dir": "/opt/enhance-pir/infra/production",
  "tfvars_file": "/etc/enhance-pir/production.tfvars",
  "artifact_dir": "/opt/enhance-pir/autoscale-release",
  "current_release_file": "/opt/enhance-pir/current-coordinator-release",
  "qualification_receipt": "/etc/enhance-pir/qualification.json",
  "ssh_key": "/etc/enhance-pir/deploy-key",
  "known_hosts": "/etc/enhance-pir/known-hosts"
}
