# Rendered by ops/scripts/deploy-transparent-shard.sh, which substitutes the
# placeholder site name below with the host of TRANSPARENT_PUBLIC_URL before the
# file is validated and installed. The placeholder is deliberately not repeated
# in this comment: the substitution is a plain sed over the whole file, and a
# second occurrence would be rewritten into a sentence that no longer parses.
#
# This runs on the worker, not on the Enhance coordinator. The coordinator's
# Caddyfile is rendered and installed by deploy-enhance-pir.sh, and a token that
# script does not substitute would fail `caddy validate` on its next deploy —
# breaking a live service over a change that has nothing to do with it. Keeping
# the transparent fleet's edge here means the two never share a file.
TRANSPARENT_PUBLIC_HOST {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
		}
	}

	# The service already refuses a body that is not exactly the fixed query
	# length, and axum caps it before that. This is the outer bound, so a large
	# upload is dropped at the edge rather than buffered through the proxy.
	request_body {
		max_size 1MB
	}

	# Only the wallet-facing surface is routed. `/v1/health`, `/v1/ready` and
	# `/metrics` are deliberately not here: they report shard counts, retained
	# revisions, cache occupancy, eviction and build rates — operator
	# information, and a running commentary on how much traffic this worker is
	# taking. The deploy verifies them over the VPC and asserts each is a 404
	# through the edge, because the way this goes wrong is a route wider than
	# intended and the failure is otherwise silent.
	#
	# `/v1/shards*` covers the revision-addressed private routes, which are
	# `/v1/shards/{id}/revisions/{digest}/...`.
	handle /v1/shards* {
		reverse_proxy 127.0.0.1:8093
	}

	# The public range filters, served here as well as by the filter service on
	# its own host. Same paths on both, so a wallet points at either origin by
	# changing only the base URL. This is a relaxation of the rule that kept
	# public bytes off the origin that answers private requests; what it
	# preserves is the option, since the filter service still offers the same
	# bytes elsewhere for a wallet that wants to fetch the two over different
	# network paths.
	handle /v1/filters/* {
		reverse_proxy 127.0.0.1:8093
	}

	handle {
		respond 404
	}
}
