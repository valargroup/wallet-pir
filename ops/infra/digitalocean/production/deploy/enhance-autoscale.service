[Unit]
Description=Enhance PIR append-only capacity controller
After=network-online.target enhance-pir-server.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
# The host's narrowly scoped Infisical machine identity must be configured first.
ExecStart=/usr/local/bin/infisical run --env=prod --projectId=40862c6d-a089-4355-b405-0477be0ee3b1 -- /usr/bin/python3 /opt/enhance-pir/ops/enhance-autoscale.py --config /etc/enhance-pir/autoscale.json tick
TimeoutStartSec=50min
Nice=10
Environment=TF_IN_AUTOMATION=1
