[Unit]
Description=Enhance PIR append-only capacity controller
After=network-online.target enhance-pir-server.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
LoadCredentialEncrypted=runtime:/etc/credstore.encrypted/enhance-pir-runtime
ExecStart=/usr/bin/python3 /opt/enhance-pir/ops/enhance-runtime.py /usr/bin/python3 /opt/enhance-pir/ops/enhance-autoscale.py --config /etc/enhance-pir/autoscale.json tick
TimeoutStartSec=50min
Nice=10
Environment=TF_IN_AUTOMATION=1
