{
  "_comment": "Example /etc/pir-quality/hosts.json for quality-host-sampler.py. Addresses are placeholders; copy the private addresses from Terraform output or the roster. Only v12 history and the one-query txid display site are sampled.",
  "ssh": {
    "key": "/etc/pir-quality/ssh/id_ed25519",
    "known_hosts": "/etc/pir-quality/ssh/known_hosts"
  },
  "output": "/var/lib/pir-apm/hosts.json",
  "edge_output": "/var/lib/pir-apm/edge.prom",
  "roster": {
    "path": "/opt/transparent-publisher/v12/roster.json",
    "unit": "transparent-shard-server.service",
    "role_units": {
      "archive-owner": "transparent-v12-archive.service",
      "recent-replica": "transparent-v12-recent.service"
    },
    "data_dir": "/srv/transparent-pir",
    "size": "m-8vcpu-64gb"
  },
  "targets": [
    {
      "sources": ["transparent-publisher"],
      "host_id": "wallet-pir-coordinator-01",
      "unit": "transparent-v12-publish-controller.service",
      "units": [
        "transparent-txid-display-k8-controller.service",
        "pir-apm.service"
      ],
      "data_dir": "/"
    },
    {
      "sources": ["transparent-edge"],
      "host_id": "transparent-pir-router",
      "unit": "caddy.service",
      "data_dir": "/",
      "host": "root@10.0.0.2",
      "edge": true
    },
    {
      "sources": ["transparent-pir-txid-k8-01"],
      "size": "m-8vcpu-64gb-intel",
      "unit": "transparent-txid-display-worker.service",
      "units": ["caddy.service"],
      "data_dir": "/srv/transparent-txid-display",
      "host": "root@10.0.0.3"
    }
  ]
}
