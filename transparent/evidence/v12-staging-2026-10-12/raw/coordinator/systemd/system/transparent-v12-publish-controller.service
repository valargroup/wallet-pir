[Unit]
Description=Continuous transparent PIR v12 publication (follows the v11 journal read-only)
After=network-online.target zakurad.service transparent-publish-controller.service
Wants=network-online.target

[Service]
Environment=PYTHONDONTWRITEBYTECODE=1
Type=simple
User=root
WorkingDirectory=/opt/transparent-publisher/v12
ExecStart=/opt/transparent-publisher/v12/releases/fb90519b/bin/transparent-publish-controller --config /opt/transparent-publisher/v12/controller.json
Restart=on-failure
RestartSec=3
UMask=0077
Nice=10
IOSchedulingClass=idle
MemoryMax=8G
MemorySwapMax=0
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadOnlyPaths=/srv/transparent-activity/full-v3/journal /opt/transparent-publisher/credentials
ReadWritePaths=/srv/transparent-activity/full-v12 /opt/transparent-publisher/v12/state

[Install]
WantedBy=multi-user.target
