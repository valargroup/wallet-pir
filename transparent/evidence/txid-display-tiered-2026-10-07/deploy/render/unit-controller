[Unit]
Description=Transparent txid display controller (proof of concept)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# Rendered by `wallet-pir-deploy.py txid-display-deploy --phase controller` from
# the reviewed request; transparent/ops/lib/txid_display_poc.py owns the values.
# The controller is the display journal's only writer once the backfill unit has
# exited. It reaches the workers through workers.json: the archive owner first,
# then the recent replica that serves the map.
ExecStart=/opt/transparent-txid-display/releases/d191f86b2873e4250cee3ae6952f830c0d1e7a55/txid-display-controller run --root /srv/zakura/txid-display-poc/root --journal /srv/zakura/txid-display-poc/journal --workers /opt/transparent-txid-display/workers.json --mode replay-then-live --status-listen 127.0.0.1:8099 --rpc-url http://127.0.0.1:8232 --rpc-cookie /root/.cache/zakura/.cookie --blocks-per-step 25 --step-interval-ms 2000
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=10
UMask=0077
# Below the history controller (Nice=5, MemoryMax=8G) on every axis.
MemoryMax=4G
MemorySwapMax=0
CPUQuota=200%
CPUWeight=20
IOWeight=20
Nice=10
OOMScoreAdjust=500
NoNewPrivileges=yes
PrivateTmp=yes
# No ProtectHome: the node's RPC cookie under /root must stay readable.
ProtectSystem=strict
ReadWritePaths=/srv/zakura/txid-display-poc/root /srv/zakura/txid-display-poc/journal /opt/transparent-txid-display/state
ReadOnlyPaths=/opt/transparent-publisher/credentials

[Install]
WantedBy=multi-user.target
