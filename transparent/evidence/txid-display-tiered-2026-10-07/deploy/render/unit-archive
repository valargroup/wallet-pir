[Unit]
Description=Transparent txid display worker, archive-owner (proof of concept)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# Rendered by `wallet-pir-deploy.py txid-display-deploy --phase workers` from the
# reviewed request; transparent/ops/lib/txid_display_poc.py owns the values.
# The worker starts with no publication. The deploy and then the controller
# stage, prepare and activate publications through the control socket only.
# Every path is outside /srv/transparent-pir and /opt/transparent-publisher, so
# history collectors, pruning and survey roots never see display data.
# The controller ships a candidate every cycle; its `collect` deletes unused
# candidates from the publications root and sealed revisions that left the
# window from the staged root. The server keeps a staged revision whose shard
# is not yet published, so a background stage still owns it from ship to stage.
ExecStart=/opt/transparent-txid-display/releases/d191f86b2873e4250cee3ae6952f830c0d1e7a55/transparent-txid-server --listen 10.142.0.7:8095 --role archive-owner --cache-bytes 4294967296 --build-slots 1 --query-slots 2 --retain-revisions 2 --control-socket /run/transparent-txid-display/control.sock --active-record /opt/transparent-txid-display/worker/active.json --collect-root /srv/transparent-txid-display/publications --collect-root /srv/transparent-txid-display/staged --runtime-cache-dir /srv/transparent-txid-display/runtime-cache --runtime-cache-max-bytes 8589934592
Environment=RUST_LOG=info
Environment=TRANSPARENT_BUILD_THREADS=2
Restart=on-failure
RestartSec=10
RuntimeDirectory=transparent-txid-display
RuntimeDirectoryMode=0700
LimitNOFILE=1048576
# Display always loses to the history worker on the same host: a lower CPU and
# IO weight, a hard CPU quota, no swap, and the OOM killer's first choice.
MemoryMax=6G
MemorySwapMax=0
CPUQuota=200%
CPUWeight=20
IOWeight=20
Nice=10
OOMScoreAdjust=1000
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/srv/transparent-txid-display /opt/transparent-txid-display/worker

[Install]
WantedBy=multi-user.target
