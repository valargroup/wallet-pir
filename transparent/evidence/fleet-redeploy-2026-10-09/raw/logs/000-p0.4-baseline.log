### cmd:

mkdir -p $DEP/baseline && cd $DEP/baseline
cp -p /opt/transparent-publisher/v11/{fleet.json,controller.json,roster.json} /opt/transparent-publisher/v11/state/membership.json $LOAD/pins.json $LOAD/status.json .
curl -s 127.0.0.1:8094/v1/status > controller-status.json
for h in $R01 $R02 $A03; do curl -s http://$h:8093/v1/ready > ready-$h.json; done
for h in $TD01 $R01; do curl -s http://$h:8095/v1/ready > txid-ready-$h.json; done
curl -s https://transparent-pir.valargroup.dev/v1/shards > map-public.json
curl -s https://enhance-pir.valargroup.dev/v1/filters/shards > map-filters.json
cmp map-public.json map-filters.json && echo origins-agree
sha256sum /usr/local/bin/{transparent-publish-controller,shard-assign,shard-control,transparent-filter-server} | tee coordinator-bins.txt
for h in $R01 $R02 $A03; do $W root@$h "hostname; sha256sum /usr/local/bin/transparent-shard-server /usr/local/bin/shard-control /etc/systemd/system/transparent-shard-server.service; free -b | sed -n 2p; df -B1 / | tail -1; systemctl show transparent-shard-server -p NRestarts -p MemoryCurrent -p MainPID; sha256sum /proc/\$(systemctl show -p MainPID --value transparent-shard-server)/exe" > host-$h.txt; cat host-$h.txt; done
grep -E "caddy_http_request_duration_seconds_count\{code=\"5" /var/lib/pir-apm/edge.prom > router-5xx.prom || true
wc -l router-5xx.prom; ls -la; sha256sum map-public.json

