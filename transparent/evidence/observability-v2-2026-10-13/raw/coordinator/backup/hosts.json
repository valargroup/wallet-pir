{
  "ssh": {
    "key": "/opt/transparent-publisher/credentials/deploy-ssh",
    "known_hosts": "/opt/transparent-publisher/credentials/known_hosts"
  },
  "targets": [
    {
      "sources": [
        "transparent-publisher"
      ],
      "unit": "transparent-publish-controller.service",
      "data_dir": "/srv/zakura"
    },
    {
      "sources": [
        "enhance-init"
      ],
      "unit": "enhance-pir-coordinator.service",
      "data_dir": "/srv/zakura"
    },
    {
      "sources": [
        "enhance-query-0"
      ],
      "unit": "enhance-pir-query-ingress.service",
      "data_dir": "/"
    },
    {
      "sources": [
        "transparent-edge"
      ],
      "unit": "caddy.service",
      "data_dir": "/",
      "host": "root@10.142.0.11",
      "edge": true
    }
  ],
  "output": "/var/lib/pir-apm/hosts.json",
  "edge_output": "/var/lib/pir-apm/edge.prom",
  "roster": {
    "path": "/opt/transparent-publisher/v11/roster.json",
    "unit": "transparent-shard-server.service",
    "data_dir": "/"
  }
}
