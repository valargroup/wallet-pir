{
  "ssh": {
    "key": "/opt/transparent-publisher/credentials/deploy-ssh",
    "known_hosts": "/opt/transparent-publisher/credentials/known_hosts"
  },
  "targets": [
    {
      "sources": ["transparent-publisher"],
      "host_id": "wallet-pir-coordinator-01",
      "size": "m-8vcpu-64gb-intel",
      "unit": "transparent-v12-publish-controller.service",
      "units": ["zakurad.service", "transparent-publish-controller.service", "transparent-txid-display-controller.service",
                "transparent-filter-server.service", "enhance-pir-coordinator.service", "pir-apm.service"],
      "data_dir": "/srv/zakura"
    },
    {
      "sources": ["txid-controller"],
      "host_id": "wallet-pir-coordinator-01",
      "size": "m-8vcpu-64gb-intel",
      "unit": "transparent-txid-display-k8-controller.service",
      "data_dir": "/srv/txid-display-genesis"
    },
    {
      "sources": ["enhance-init"],
      "host_id": "wallet-pir-coordinator-01",
      "unit": "enhance-pir-coordinator.service",
      "data_dir": "/srv/zakura"
    },
    {
      "sources": ["enhance-query-0"],
      "host_id": "wallet-pir-coordinator-01",
      "unit": "enhance-pir-query-ingress.service",
      "data_dir": "/"
    },
    {
      "sources": ["transparent-pir-v12-archive"],
      "host_id": "transparent-pir-v12-01",
      "size": "m-8vcpu-64gb",
      "unit": "transparent-v12-archive.service",
      "data_dir": "/",
      "host": "root@10.142.0.9"
    },
    {
      "sources": ["transparent-pir-v12-recent"],
      "host_id": "transparent-pir-v12-01",
      "size": "m-8vcpu-64gb",
      "unit": "transparent-v12-recent.service",
      "data_dir": "/",
      "host": "root@10.142.0.9"
    },
    {
      "sources": ["transparent-edge"],
      "host_id": "transparent-pir-v12-01",
      "size": "m-8vcpu-64gb",
      "unit": "caddy.service",
      "data_dir": "/",
      "host": "root@10.142.0.9",
      "edge": true
    },
    {
      "sources": ["transparent-pir-router-01"],
      "host_id": "transparent-pir-router-01",
      "size": "s-2vcpu-4gb",
      "unit": "caddy.service",
      "data_dir": "/",
      "host": "root@10.142.0.11"
    },
    {
      "sources": ["transparent-pir-txid-k8-01"],
      "host_id": "transparent-pir-txid-k8-01",
      "size": "m-8vcpu-64gb-intel",
      "unit": "transparent-txid-display-worker.service",
      "units": ["caddy.service"],
      "data_dir": "/",
      "host": "root@10.142.0.18"
