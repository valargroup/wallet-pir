{
	servers {
		metrics
	}
}
transparent-pir.valargroup.dev {
	request_body {
		max_size 1MB
	}
	# Wallet API v1 (the v11 history fleet and the txid-2k display site) was
	# retired on 2026-10-13. Wallets on an older client get an explicit answer
	# instead of a bare 404.
	handle /v1/* {
		header Content-Type application/json
		respond `{"error":"api_version_retired","retired":"/v1","use":"/v2"}` 410
	}
	# Wallet API v2: /v2/txid goes to the one-query txid display site; every
	# other /v2 path goes to the v12 fleet's router, whose site answers under its
	# own address. Caddy orders the longer path first.
	handle /v2/txid/* {
		reverse_proxy 10.142.0.18:8095
	}
	handle /v2/* {
		reverse_proxy 10.142.0.9:8080 {
			header_up Host {upstream_hostport}
		}
	}
	handle {
		respond 404
	}

	handle_errors {
		header Retry-After 1
		respond "no worker could take the request; retry shortly"
	}
}

http://10.142.0.11:8080 {
	request_body {
		max_size 1MB
	}
	# Wallet API v1 (the v11 history fleet and the txid-2k display site) was
	# retired on 2026-10-13. Wallets on an older client get an explicit answer
	# instead of a bare 404.
	handle /v1/* {
		header Content-Type application/json
		respond `{"error":"api_version_retired","retired":"/v1","use":"/v2"}` 410
	}
	# Wallet API v2: /v2/txid goes to the one-query txid display site; every
	# other /v2 path goes to the v12 fleet's router, whose site answers under its
	# own address. Caddy orders the longer path first.
	handle /v2/txid/* {
		reverse_proxy 10.142.0.18:8095
	}
	handle /v2/* {
		reverse_proxy 10.142.0.9:8080 {
			header_up Host {upstream_hostport}
		}
	}
	handle {
		respond 404
	}

	handle_errors {
		header Retry-After 1
		respond "no worker could take the request; retry shortly"
	}
}
