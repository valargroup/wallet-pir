BEGIN { printf("start monotonic_ns=%llu\n",nsecs); }
tracepoint:sched:sched_switch /args->prev_pid == 0 || args->next_pid == 0/
{ @last[cpu]=(uint64)0; }
profile:hz:49
{
 $now=nsecs;
 if (@last[cpu] && $now-@last[cpu] > 200000000) {
  printf("cpu_gap monotonic_ns=%llu cpu=%d nanoseconds=%llu previous_tid=%d current_tid=%d current_pid=%d comm=%s\n",$now,cpu,$now-@last[cpu],@lasttid[cpu],tid,pid,comm);
  printf("previous_stack=%s\ncurrent_stack=%s\n",@laststack[cpu],kstack(20));
 }
 @laststack[cpu]=kstack(20);
 @last[cpu]=$now;@lasttid[cpu]=tid;
}
interval:s:900 {exit();}
END {printf("end monotonic_ns=%llu\n",nsecs);clear(@last);clear(@lasttid);clear(@laststack);}
