BEGIN { printf("start monotonic_ns=%llu pid=679049\n",nsecs); }
tracepoint:syscalls:sys_enter_madvise,tracepoint:syscalls:sys_enter_fadvise64 /pid == 679049/
{ @start[tid]=nsecs;@kind[tid]=probe; }
tracepoint:syscalls:sys_exit_madvise,tracepoint:syscalls:sys_exit_fadvise64 /pid == 679049 && @start[tid]/
{
 $elapsed=nsecs-@start[tid];
 if ($elapsed>100000000) {printf("slow_advice monotonic_ns=%llu tid=%d call=%s nanoseconds=%llu return=%d\n",nsecs,tid,@kind[tid],$elapsed,args->ret);}
 delete(@start[tid]);delete(@kind[tid]);
}
interval:s:900 {exit();}
END {printf("end monotonic_ns=%llu\n",nsecs);clear(@start);clear(@kind);}
