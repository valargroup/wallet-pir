BEGIN
{
 @tracked[649049]=1; @tracked[649050]=1; @tracked[649051]=1;
 @tracked[649052]=1; @tracked[649053]=1; @tracked[649293]=1;
 @tracked[649294]=1; @tracked[649295]=1; @tracked[649296]=1;
 printf("{\"event\":\"start\",\"monotonic_ns\":%llu,\"worker_pid\":649049}\n", nsecs);
}
tracepoint:sched:sched_process_fork /@tracked[args->parent_pid]/
{ @tracked[args->child_pid]=1; }
tracepoint:sched:sched_wakeup /@tracked[args->pid]/
{ @queued[args->pid]=nsecs; }
tracepoint:sched:sched_switch
{
 if (@tracked[args->prev_pid] && args->prev_state == 0) {
  @queued[args->prev_pid]=nsecs;
 }
 if (@tracked[args->next_pid] && @queued[args->next_pid]) {
  $wait=nsecs-@queued[args->next_pid];
  if ($wait > 100000000) {
   printf("{\"event\":\"runnable_wait\",\"monotonic_ns\":%llu,\"tid\":%d,\"cpu\":%d,\"nanoseconds\":%llu}\n",nsecs,args->next_pid,cpu,$wait);
  }
  delete(@queued[args->next_pid]);
 }
}
tracepoint:syscalls:sys_enter_fsync /pid == 649049/
{ @fsync[tid]=nsecs; }
tracepoint:syscalls:sys_exit_fsync /pid == 649049 && @fsync[tid]/
{
 $elapsed=nsecs-@fsync[tid];
 if ($elapsed > 100000000) {
  printf("{\"event\":\"fsync\",\"monotonic_ns\":%llu,\"tid\":%d,\"cpu\":%d,\"nanoseconds\":%llu,\"return\":%d}\n",nsecs,tid,cpu,$elapsed,args->ret);
 }
 delete(@fsync[tid]);
}
tracepoint:sched:sched_process_exit /@tracked[tid]/
{ delete(@tracked[tid]); delete(@queued[tid]); delete(@fsync[tid]); }
interval:s:900 { exit(); }
END
{
 printf("{\"event\":\"end\",\"monotonic_ns\":%llu}\n",nsecs);
 clear(@tracked); clear(@queued); clear(@fsync);
}
