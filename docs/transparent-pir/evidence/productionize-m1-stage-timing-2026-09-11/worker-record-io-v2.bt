BEGIN { printf("{\"event\":\"start\",\"monotonic_ns\":%llu,\"pid\":695393}\n",nsecs); }
tracepoint:syscalls:sys_enter_openat /pid == 695393/ { @open_start[tid]=nsecs; @open_path[tid]=str(args->filename); }
tracepoint:syscalls:sys_exit_openat /pid == 695393 && @open_start[tid]/ {
 $elapsed=nsecs-@open_start[tid];
 if ($elapsed>10000000) { printf("{\"event\":\"openat\",\"monotonic_ns\":%llu,\"nanoseconds\":%llu,\"path\":\"%s\",\"return\":%d}\n",nsecs,$elapsed,@open_path[tid],args->ret); }
 delete(@open_start[tid]);delete(@open_path[tid]);
}
tracepoint:syscalls:sys_enter_write /pid == 695393/ { @write_start[tid]=nsecs; @write_fd[tid]=args->fd; }
tracepoint:syscalls:sys_exit_write /pid == 695393 && @write_start[tid]/ {
 $elapsed=nsecs-@write_start[tid];
 if ($elapsed>10000000) { printf("{\"event\":\"write\",\"monotonic_ns\":%llu,\"nanoseconds\":%llu,\"fd\":%d,\"return\":%d}\n",nsecs,$elapsed,@write_fd[tid],args->ret); }
 delete(@write_start[tid]);delete(@write_fd[tid]);
}
tracepoint:syscalls:sys_enter_rename /pid == 695393/ { @rename_start[tid]=nsecs; @rename_path[tid]=str(args->newname); }
tracepoint:syscalls:sys_exit_rename /pid == 695393 && @rename_start[tid]/ {
 $elapsed=nsecs-@rename_start[tid];
 if ($elapsed>10000000) { printf("{\"event\":\"rename\",\"monotonic_ns\":%llu,\"nanoseconds\":%llu,\"path\":\"%s\",\"return\":%d}\n",nsecs,$elapsed,@rename_path[tid],args->ret); }
 delete(@rename_start[tid]);delete(@rename_path[tid]);
}
interval:s:600 { exit(); }
END { printf("{\"event\":\"end\",\"monotonic_ns\":%llu}\n",nsecs); clear(@open_start);clear(@open_path);clear(@write_start);clear(@write_fd);clear(@rename_start);clear(@rename_path); }
