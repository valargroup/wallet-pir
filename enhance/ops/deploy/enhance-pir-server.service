[Unit]
Description=Ironwood Enhance PIR coordinator
After=network-online.target zakurad.service
Wants=network-online.target
Requires=zakurad.service

[Service]
Type=simple
ExecStart=/opt/enhance-pir/current/enhance-pir-server coordinator --listen 127.0.0.1:8080 --data-dir /srv/enhance-pir/canonical --worker-config /etc/enhance-pir/workers.json --zakura-rpc-url http://127.0.0.1:8232 --zakura-cookie /root/.cache/zakura/.cookie
Restart=on-failure
RestartSec=10
User=root
LimitNOFILE=1048576
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
