[Unit]
Description=Enhance PIR packing router
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=enhance-pir
EnvironmentFile=/etc/enhance-pir/packing-router.env
ExecStart=/opt/enhance-pir/current/enhance-pir-server packing-router --data-dir /srv/enhance-pir-router --artifact-origin ${ENHANCE_ARTIFACT_ORIGIN} --listen ${ENHANCE_ROUTER_LISTEN} --control-listen ${ENHANCE_ROUTER_CONTROL_LISTEN} --max-objects 6 --requests 4
Restart=on-failure
RestartSec=3
MemoryHigh=7G
MemoryMax=7G
MemorySwapMax=0
LimitNOFILE=4096
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/enhance-pir-router
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
