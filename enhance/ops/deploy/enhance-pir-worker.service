[Unit]
Description=Ironwood Enhance PIR worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/enhance-pir/worker.env
ExecStart=/opt/enhance-pir/current/enhance-pir-server --sealed-shards ${ENHANCE_SEALED_SHARDS} worker --listen ${ENHANCE_WORKER_LISTEN} --data-dir /srv/enhance-pir/worker
Restart=on-failure
RestartSec=3
User=enhance-pir
LimitNOFILE=1048576
MemoryHigh=7G
MemoryMax=7609516032
MemorySwapMax=0
ReadWritePaths=/srv/enhance-pir/worker
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
