[Unit]
Description=Ironwood Enhance PIR shard worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/enhance-pir-worker --listen 0.0.0.0:8091 --data-dir /srv/enhance-pir/artifacts-v7
Restart=on-failure
RestartSec=3
User=root
LimitNOFILE=1048576
MemoryHigh=6G
MemoryMax=7G
MemorySwapMax=2G
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
