[Unit]
Description=Status PIR CPU evaluation worker (private qualification)
After=network-online.target

[Service]
User=status-pir
Group=status-pir
ExecStart=@RELEASE@/status-pir role --role worker --network-hex @NETWORK@ --listen 127.0.0.1:8481 --artifact-origin http://127.0.0.1:8495 --state-dir /var/lib/status-pir-worker-native
Environment=RAYON_NUM_THREADS=4
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=3
# The CPU worker keeps host copies of the database, hints and the previous
# generation: about 4.2 GB anonymous memory under 20 QPS with live updates.
MemoryMax=6G
MemorySwapMax=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/status-pir-worker-native

[Install]
WantedBy=multi-user.target
