+//! Arrival and capacity policy shared by the coordinator's current scheduler
+//! and a future worker-local scheduler.
+use std::{
+    collections::VecDeque,
+    time::{Duration, Instant},
+};
+
+pub const MAX_BATCH: usize = 8;
+pub const ARRIVAL_WINDOW: Duration = Duration::from_secs(1);
+pub const MAX_EXTRA_WAIT: Duration = Duration::from_millis(20);
+
+#[derive(Default)]
+pub struct RecentArrivals {
+    times: VecDeque<Instant>,
+}
+
+impl RecentArrivals {
+    pub fn record(&mut self, now: Instant) {
+        self.times.push_back(now);
+        self.prune(now);
+    }
+
+    pub fn prune(&mut self, now: Instant) {
+        while self
+            .times
+            .front()
+            .is_some_and(|at| now.duration_since(*at) > ARRIVAL_WINDOW)
+        {
+            self.times.pop_front();
+        }
+    }
+
+    pub fn rate_per_second(&self) -> f64 {
+        self.times.len() as f64 / ARRIVAL_WINDOW.as_secs_f64()
+    }
+
+    pub fn predicts_arrival_within(&self, wait: Duration) -> bool {
+        if self.times.len() < 4 || wait.is_zero() {
+            return false;
+        }
+        let span = self
+            .times
+            .back()
+            .unwrap()
+            .duration_since(*self.times.front().unwrap());
+        span <= wait.saturating_mul((self.times.len() - 1) as u32)
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.times.is_empty()
+    }
+}
+
+pub fn collection_delay(
+    arrivals: &RecentArrivals,
+    pending: usize,
+    batch_limit: usize,
+    worker_busy: bool,
+    configured: Duration,
+) -> Duration {
+    if !worker_busy || pending >= batch_limit || !arrivals.predicts_arrival_within(configured) {
+        Duration::ZERO
+    } else {
+        configured.min(MAX_EXTRA_WAIT)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_sustained_compatible_arrivals_enable_wait() {
+        let now = Instant::now();
+        let mut arrivals = RecentArrivals::default();
+        for offset in 0..4 {
+            arrivals.record(now + Duration::from_millis(offset * 5));
+        }
+        let delay = Duration::from_millis(10);
+        assert_eq!(
+            collection_delay(&arrivals, 1, MAX_BATCH, true, delay),
+            delay
+        );
+        assert_eq!(
+            collection_delay(&arrivals, 1, MAX_BATCH, false, delay),
+            Duration::ZERO
+        );
+        assert_eq!(
+            collection_delay(&arrivals, MAX_BATCH, MAX_BATCH, true, delay),
+            Duration::ZERO
+        );
+        assert_eq!(
+            collection_delay(&arrivals, 1, MAX_BATCH, true, Duration::ZERO),
+            Duration::ZERO
+        );
+        arrivals.prune(now + Duration::from_secs(2));
+        assert!(arrivals.is_empty());
+        assert_eq!(
+            collection_delay(&arrivals, 1, MAX_BATCH, true, delay),
+            Duration::ZERO
+        );
+    }
+
+    #[test]
+    fn evenly_spaced_low_rate_does_not_enable_wait() {
+        let now = Instant::now();
+        let mut arrivals = RecentArrivals::default();
+        for offset in 0..8 {
+            arrivals.record(now + Duration::from_millis(offset * 125));
+        }
+        assert_eq!(arrivals.rate_per_second(), 8.0);
+        assert_eq!(
+            collection_delay(&arrivals, 1, MAX_BATCH, true, Duration::from_millis(20)),
+            Duration::ZERO
+        );
+    }
