+async fn run_batch_queue(c: Coordinator, key: BatchKey) {
+    let slots = c.worker_slots.lock().unwrap()[&key.0].clone();
+    loop {
+        let (oldest, count, notify) = {
+            let mut queues = c.batches.lock().unwrap();
+            let Some(queue) = queues.get_mut(&key) else {
+                return;
+            };
+            queue.pending.retain(|p| !p.reply.is_closed());
+            if queue.pending.is_empty() {
+                queues.remove(&key);
+                return;
+            }
+            (
+                queue.pending[0].queued_at,
+                queue.pending.len(),
+                queue.notify.clone(),
+            )
+        };
+        let delay = {
+            let recent = c.recent_arrivals.lock().unwrap();
+            recent
+                .get(&key)
+                .map_or(std::time::Duration::ZERO, |history| {
+                    batch_policy::collection_delay(
+                        history,
+                        count,
+                        c.batch_limit,
+                        slots.available_permits() == 0,
+                        c.batch_max_delay,
+                    )
+                })
+        };
+        if !delay.is_zero() {
+            let flush_at = oldest + delay;
+            tokio::select! {
+                _ = tokio::time::sleep_until(tokio::time::Instant::from_std(flush_at)) => {},
+                _ = notify.notified() => { continue; },
+            }
+        }
+        let deadline = oldest + QUERY_WAIT_DEADLINE;
+        let permit = tokio::select! {
+            permit = tokio::time::timeout_at(
+                tokio::time::Instant::from_std(deadline),
+                slots.clone().acquire_owned(),
+            ) => permit,
+            _ = notify.notified() => continue,
+        };
+        if permit.is_err() {
+            let expired = {
+                let mut queues = c.batches.lock().unwrap();
+                let queue = queues.get_mut(&key).expect("batch queue exists");
+                let mut expired = Vec::new();
+                while queue
+                    .pending
+                    .front()
+                    .is_some_and(|p| p.queued_at.elapsed() >= QUERY_WAIT_DEADLINE)
+                {
+                    expired.push(queue.pending.pop_front().unwrap());
+                }
+                expired
+            };
+            for pending in expired {
+                c.query_stats.wait_count.fetch_add(1, Ordering::Relaxed);
+                c.query_stats.wait_micros.fetch_add(
+                    pending.queued_at.elapsed().as_micros() as u64,
+                    Ordering::Relaxed,
+                );
+                c.query_stats.rejected.fetch_add(1, Ordering::Relaxed);
+                let _ = pending.reply.send(Err(QueryError(
+                    StatusCode::TOO_MANY_REQUESTS,
+                    "query wait deadline".into(),
+                )));
+            }
+            continue;
+        }
+        let mut batch = {
+            let mut queues = c.batches.lock().unwrap();
+            let queue = queues.get_mut(&key).expect("batch queue exists");
+            (0..c.batch_limit)
+                .filter_map(|_| queue.pending.pop_front())
+                .filter(|p| !p.reply.is_closed())
+                .collect::<Vec<_>>()
+        };
+        if batch.is_empty() {
+            continue;
+        }
+        let now = std::time::Instant::now();
+        let mut ready = Vec::new();
+        for mut pending in batch.drain(..) {
+            let wait = now.duration_since(pending.queued_at);
+            c.query_stats.wait_count.fetch_add(1, Ordering::Relaxed);
+            c.query_stats
+                .wait_micros
+                .fetch_add(wait.as_micros() as u64, Ordering::Relaxed);
+            if wait >= QUERY_WAIT_DEADLINE {
+                c.query_stats.rejected.fetch_add(1, Ordering::Relaxed);
+                let _ = pending.reply.send(Err(QueryError(
+                    StatusCode::TOO_MANY_REQUESTS,
+                    "query wait deadline".into(),
+                )));
+            } else {
+                drop(pending.waiting.take());
+                ready.push(pending);
+            }
+        }
+        if let Ok(Ok(permit)) = permit {
+            if !ready.is_empty() {
+                let reason = if ready.len() == c.batch_limit {
+                    &c.query_stats.batch_full_flush
+                } else if delay.is_zero() {
+                    &c.query_stats.batch_immediate_flush
+                } else {
+                    &c.query_stats.batch_pressure_flush
+                };
+                reason.fetch_add(1, Ordering::Relaxed);
+                let dispatch = c.clone();
+                let worker_url = key.0.clone();
+                tokio::spawn(async move {
+                    dispatch_batch(&dispatch, ready, permit, &worker_url).await;
+                });
+            }
+        }
+    }
+}
