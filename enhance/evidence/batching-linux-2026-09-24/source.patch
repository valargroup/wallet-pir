+fn select_replica(c: &Coordinator, routes: &[String]) -> String {
+    let slots = c.worker_slots.lock().unwrap();
+    let queues = c.batches.lock().unwrap();
+    let start = c.query_stats.route_cursor.fetch_add(1, Ordering::Relaxed) as usize % routes.len();
+    (0..routes.len())
+        .map(|offset| &routes[(start + offset) % routes.len()])
+        .min_by_key(|url| {
+            let available = slots.get(*url).map_or(0, |slot| slot.available_permits());
+            let waiting: usize = queues
+                .iter()
+                .filter(|(key, _)| &key.0 == *url)
+                .map(|(_, queue)| queue.pending.len())
+                .sum();
+            (
+                available == 0,
+                waiting,
+                WORKER_ACTIVE_LIMIT.saturating_sub(available),
+            )
+        })
+        .expect("nonempty replica routes")
+        .clone()
+}
