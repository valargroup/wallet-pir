+    /// Evaluate several first-dimension queries while streaming each database column once.
+    pub fn evaluate_batch(
+        &self,
+        rlwe: &RlweParams,
+        queries: &[&[u64]],
+    ) -> Result<Vec<Vec<u64>>, InspiringError> {
+        let rows = self.server.db_rows_padded();
+        if queries.is_empty() || queries.len() > 8 || queries.iter().any(|q| q.len() != rows) {
+            return Err(InspiringError::LweShape(
+                "invalid batched query shape".into(),
+            ));
+        }
+        if queries.iter().any(|q| q.iter().any(|v| *v >= rlwe.q)) {
+            return Err(InspiringError::PreprocessMismatch(
+                "query coefficient is not reduced modulo q".into(),
+            ));
+        }
+        let count = queries.len();
+        if rows > 8192 {
+            return Err(InspiringError::LweShape(
+                "batched unit exceeds 8192 rows".into(),
+            ));
+        }
+        if count == 1 {
+            return Ok(vec![self.evaluate(rlwe, queries[0])?]);
+        }
