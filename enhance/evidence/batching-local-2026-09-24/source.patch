+/// Pack the small query panel by row so each column scan reads contiguous
+/// coefficients for all lanes. The fixed lane count lets LLVM unroll the hot
+/// multiply-accumulate loop instead of indexing eight separate query slices.
+fn multiply_batch<const K: usize>(
+    db: &[u16],
+    rows: usize,
+    cols: usize,
+    modulus: u64,
+    queries: &[&[u64]],
+) -> Vec<Vec<u64>> {
+    let panel: Vec<([u32; K], [u32; K])> = (0..rows)
+        .map(|row| {
+            (
+                std::array::from_fn(|lane| queries[lane][row] as u32),
+                std::array::from_fn(|lane| (queries[lane][row] >> 32) as u32),
+            )
+        })
+        .collect();
+    let mut column_major = vec![0u64; cols * K];
+    column_major
+        .par_chunks_mut(K)
+        .enumerate()
+        .for_each(|(col, out)| {
+            let database_column = &db[col * rows..(col + 1) * rows];
+            #[cfg(target_arch = "aarch64")]
+            if K == 8 {
+                multiply_column_neon(database_column, &panel, out, modulus);
+                return;
+            }
+            let mut lo = [0u64; K];
+            let mut hi = [0u64; K];
+            for (&value, (query_lo, query_hi)) in database_column.iter().zip(&panel) {
+                let value = u64::from(value);
+                for lane in 0..K {
+                    lo[lane] += u64::from(query_lo[lane]) * value;
+                    hi[lane] += u64::from(query_hi[lane]) * value;
+                }
+            }
+            for lane in 0..K {
+                out[lane] =
+                    ((lo[lane] as u128 + ((hi[lane] as u128) << 32)) % modulus as u128) as u64;
+            }
+        });
+    let mut answers = vec![vec![0u64; cols]; K];
+    for (col, values) in column_major.chunks_exact(K).enumerate() {
+        for lane in 0..K {
+            answers[lane][col] = values[lane];
+        }
+    }
+    answers
+}
