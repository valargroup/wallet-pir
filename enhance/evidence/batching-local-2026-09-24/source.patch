+async fn evaluate_batch(
+    State(w): State<Worker>,
+    request: Request,
+) -> ApiResult<Json<IntermediateBatch>> {
+    let permit = w
+        .evaluation
+        .clone()
+        .try_acquire_owned()
+        .map_err(|_| (StatusCode::TOO_MANY_REQUESTS, "evaluation limit".into()))?;
+    let bytes = tokio::time::timeout(
+        std::time::Duration::from_secs(30),
+        to_bytes(request.into_body(), 8 * 1024 * 1024),
+    )
+    .await
+    .map_err(unavailable)?
+    .map_err(unavailable)?;
+    let batch: EvaluateBatch =
+        serde_json::from_slice(&bytes).map_err(|e| (StatusCode::BAD_REQUEST, e.to_string()))?;
+    if batch.queries.is_empty() || batch.queries.len() > 8 {
+        return Err((StatusCode::BAD_REQUEST, "invalid batch size".into()));
+    }
+    let first = &batch.queries[0];
+    if batch.queries.iter().any(|q| {
+        q.generation != first.generation || q.shard_id != first.shard_id || q.epoch != first.epoch
+    }) {
+        return Err((StatusCode::BAD_REQUEST, "mixed batch bindings".into()));
+    }
+    let active = ActiveQueries::new(w.active_queries.clone(), batch.queries.len() as u64);
+    let evaluation = {
+        let i = w.inner.lock().unwrap();
+        let (manifest, assignment) =
+            if let Some((manifest, _)) = i.disk.published.get(&first.generation) {
+                (manifest, &i.published[&first.generation])
+            } else if let Some(manifest) = i
+                .disk
+                .activated
+                .as_ref()
+                .filter(|m| m.generation == first.generation)
+            {
+                (manifest, &i.candidate)
+            } else {
+                return Err((StatusCode::GONE, "expired session".into()));
+            };
+        let session = manifest
+            .sessions
+            .iter()
+            .find(|s| s.shard_id == first.shard_id)
+            .ok_or((StatusCode::BAD_REQUEST, "wrong shard".into()))?;
+        if session.public_params_sha256[..16] != first.epoch {
+            return Err((StatusCode::BAD_REQUEST, "epoch mismatch".into()));
+        }
+        assignment
+            .get(&first.shard_id)
+            .cloned()
+            .ok_or((StatusCode::BAD_REQUEST, "wrong group".into()))?
+    };
+    let batch_count = w.batch_count.clone();
+    let batch_queries = w.batch_queries.clone();
+    let batch_scan_micros = w.batch_scan_micros.clone();
+    let result = tokio::task::spawn_blocking(move || {
+        let _permit = permit;
+        let _active = active;
+        let count = batch.queries.len() as u64;
+        let started = std::time::Instant::now();
+        let coefficients: Vec<Vec<u64>> = batch
+            .queries
+            .iter()
+            .map(|q| q.coefficients.clone())
+            .collect();
+        let answers = evaluation.evaluate_batch(&coefficients)?;
+        batch_count.fetch_add(1, Ordering::Relaxed);
+        batch_queries.fetch_add(count, Ordering::Relaxed);
+        batch_scan_micros.fetch_add(started.elapsed().as_micros() as u64, Ordering::Relaxed);
+        Ok::<_, String>(IntermediateBatch {
+            answers: batch
+                .queries
+                .into_iter()
+                .zip(answers)
+                .map(|(query, coefficients)| Intermediate {
+                    generation: query.generation,
+                    shard_id: query.shard_id,
+                    epoch: query.epoch,
+                    coefficients,
+                })
+                .collect(),
+        })
+    })
+    .await
+    .map_err(unavailable)?
+    .map_err(|e| (StatusCode::BAD_REQUEST, e))?;
+    Ok(Json(result))
+}
