+/// NEON multiplies four query lanes at a time while each database value is hot.
+/// The caller uses this only for K=8 and units of at most 8192 rows, so every
+/// split-limb accumulator fits in u64 before the final reduction.
+#[cfg(target_arch = "aarch64")]
+fn multiply_column_neon<const K: usize>(
+    database_column: &[u16],
+    panel: &[([u32; K], [u32; K])],
+    out: &mut [u64],
+    modulus: u64,
+) {
+    use std::arch::aarch64::{
+        vdup_n_u32, vdupq_n_u64, vget_high_u32, vget_low_u32, vld1q_u32, vmlal_u32, vst1q_u64,
+    };
+    debug_assert_eq!(K, 8);
+    // SAFETY: K=8 provides eight initialized u32 values in each panel row and
+    // eight u64 output slots. NEON is available on every aarch64 target.
+    unsafe {
+        let zero = vdupq_n_u64(0);
+        let (mut lo0, mut lo1, mut lo2, mut lo3) = (zero, zero, zero, zero);
+        let (mut hi0, mut hi1, mut hi2, mut hi3) = (zero, zero, zero, zero);
+        for (&value, (query_lo, query_hi)) in database_column.iter().zip(panel) {
+            let scalar = vdup_n_u32(u32::from(value));
+            let qlo0 = vld1q_u32(query_lo.as_ptr());
+            let qlo1 = vld1q_u32(query_lo.as_ptr().add(4));
+            let qhi0 = vld1q_u32(query_hi.as_ptr());
+            let qhi1 = vld1q_u32(query_hi.as_ptr().add(4));
+            lo0 = vmlal_u32(lo0, vget_low_u32(qlo0), scalar);
+            lo1 = vmlal_u32(lo1, vget_high_u32(qlo0), scalar);
+            lo2 = vmlal_u32(lo2, vget_low_u32(qlo1), scalar);
+            lo3 = vmlal_u32(lo3, vget_high_u32(qlo1), scalar);
+            hi0 = vmlal_u32(hi0, vget_low_u32(qhi0), scalar);
+            hi1 = vmlal_u32(hi1, vget_high_u32(qhi0), scalar);
+            hi2 = vmlal_u32(hi2, vget_low_u32(qhi1), scalar);
+            hi3 = vmlal_u32(hi3, vget_high_u32(qhi1), scalar);
+        }
+        let mut lows = [0u64; 8];
+        let mut highs = [0u64; 8];
+        vst1q_u64(lows.as_mut_ptr(), lo0);
+        vst1q_u64(lows.as_mut_ptr().add(2), lo1);
+        vst1q_u64(lows.as_mut_ptr().add(4), lo2);
+        vst1q_u64(lows.as_mut_ptr().add(6), lo3);
+        vst1q_u64(highs.as_mut_ptr(), hi0);
+        vst1q_u64(highs.as_mut_ptr().add(2), hi1);
+        vst1q_u64(highs.as_mut_ptr().add(4), hi2);
+        vst1q_u64(highs.as_mut_ptr().add(6), hi3);
+        for lane in 0..8 {
+            out[lane] =
+                ((lows[lane] as u128 + ((highs[lane] as u128) << 32)) % modulus as u128) as u64;
+        }
+    }
