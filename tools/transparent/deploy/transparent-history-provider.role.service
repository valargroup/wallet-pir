# Standalone Transparent history provider. Only loopback administration is exposed.
# ExecStart, ExecStartPre (`pir-query-server --config <file> --verify-only`),
# the configuration under /etc/transparent-pir and paths are rendered by
# tools/transparent/lib/roles.py.
[Unit]
Description=Transparent PIR history provider
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=transparent-provider
Group=transparent-provider
ExecStart=/bin/false
Restart=on-failure
RestartSec=10
TimeoutStartSec=900
LimitNOFILE=65536
Environment=RUST_LOG=info
MemoryHigh=48G
MemoryMax=56G
MemorySwapMax=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
