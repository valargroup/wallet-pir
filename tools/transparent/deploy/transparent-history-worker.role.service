# External Transparent history worker, rendered by tools/transparent/lib/roles.py.
# It synchronizes publications from its HTTPS publisher into its state
# directory; status is on the loopback management listener. ExecStart
# (`pir-query-server --config /etc/transparent-pir/history-worker.json`), that
# configuration and paths are rendered; budgets come from the inventory.
[Unit]
Description=Transparent PIR history worker (external)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/false
Restart=on-failure
RestartSec=10
LimitNOFILE=1048576
Environment=RUST_LOG=info
RuntimeDirectory=transparent-history-worker
RuntimeDirectoryMode=0700
MemoryMax=12G
MemorySwapMax=0
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target
