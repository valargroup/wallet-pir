[Unit]
Description=Transparent PIR shard retrieval worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Bound to the VPC address, not to loopback and not to the internet. The
# firewall opens 8093 to the coordinator tag alone, so the only thing that can
# reach this is the coordinator. It is deliberately not published: the
# wallet-facing API is not designed yet, and the upstream default is loopback
# for exactly that reason.
# The command is the release's pir-query-server over one generated,
# root-owned `transparent_history` configuration,
# /etc/transparent-pir/shard-server.json (management 127.0.0.1:18190, loopback
# only). deploy-transparent-shard.sh writes it: listen on the worker's VPC
# address at 8093 (the host refuses unspecified listeners), query_slots 2, and
# shard_dir set to the versioned directory the set was shipped to, the
# same way the Caddyfile's host is substituted. It is a path per published set
# rather than one directory rewritten in place, so a rollback that restores this
# unit and that configuration also restores the set the restored binary was
# built to read. A set of another schema is refused at load, so pointing an old
# binary at a new set is an outage, and pointing it at the set it came with is
# not. `pir-query-server --config <file> --verify-only` checks the file and the
# set without listening.
#
# The configuration carries cache_bytes and build_slots, and TRANSPARENT_MEMORY_MAX
# is substituted here. A single-host pilot gets 8 GiB, 12G, one build slot and
# nothing extra; a fleet worker gets its roster's budgets and slots and
# assignment, worker_id and prune_excess, under which it loads only its
# assigned tables, prewarms them, and reports ready only once warm.
ExecStart=/usr/local/bin/pir-query-server --config /etc/transparent-pir/shard-server.json
Restart=on-failure
RestartSec=10
User=root
LimitNOFILE=1048576
Environment=RUST_LOG=info

# Sized from measurement rather than copied from the Enhance worker's 2 GiB,
# which is a different table. A shard costs about 257 MiB resident (128.5 MiB
# per table segment: a 32 MiB u16 database plus three 32 MiB pack matrices).
#
# This is now a backstop rather than the only limit. The service holds a
# byte-bounded runtime cache -- 8 GiB for the pilot -- and refuses work it cannot make
# room for, so reaching this cap means the reservation is wrong rather than
# that the set grew. The 4 GiB between the two covers what the reservation
# deliberately does not count: allocator fragmentation, the transient plaintext
# each build reads, the shared parameters, and in-flight requests.
#
# Re-measure with `shard-residency` before raising cache_bytes. Swap is off so
# a reservation that drifted low fails loudly here rather than degrading into
# thrash.
MemoryMax=TRANSPARENT_MEMORY_MAX
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
