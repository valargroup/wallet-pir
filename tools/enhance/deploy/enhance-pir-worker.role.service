# Enhance worker, rendered by tools/enhance/lib/roles.py. Fleet workers and an
# external worker share it. The worker downloads prepared material over HTTPS
# for its assigned domains. Private evaluation uses ENHANCE_INTERNAL_TOKEN when
# configured in the inventory's credential file. A packing router lists the
# worker before it serves.
# ExecStart, the config path and ReadWritePaths are rendered.
[Unit]
Description=Ironwood Enhance PIR worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=enhance-pir
ExecStart=/bin/false
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
MemoryHigh=7G
MemoryMax=7680M
MemorySwapMax=2G
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
