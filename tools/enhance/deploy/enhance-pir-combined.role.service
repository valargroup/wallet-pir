# Enhance ingress, packing router and worker in one process, rendered by
# tools/enhance/lib/roles.py. Wallets reach it on the rendered `public_listen`;
# `control_listen` is private. The process keeps `worker`, `router` and
# `ingress` state apart under its rendered `data_dir`.
# ExecStart, the config path and ReadWritePaths are rendered. The internal
# token is the inventory's credential file.
[Unit]
Description=Enhance PIR combined ingress, packing router and worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=enhance-pir
ExecStart=/bin/false
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
# The worker's budget; ingress and router add only bounded request buffers.
MemoryHigh=7G
MemoryMax=7680M
MemorySwapMax=2G
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
