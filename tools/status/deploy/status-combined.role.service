# Status worker and router in one process, rendered by tools/status/lib/roles.py.
# Wallets reach it on the rendered `public_listen`; `listen` stays private.
# ExecStart, the config path and ReadWritePaths are rendered.
[Unit]
Description=Status PIR combined worker and wallet front door
After=network-online.target

[Service]
User=status-pir
Group=status-pir
ExecStart=/bin/false
Environment=RAYON_NUM_THREADS=4
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=3
# The worker's host copies of the database, hints and retained generations
# dominate; the router adds packing buffers. See status-worker.service.in.
MemoryMax=12G
MemorySwapMax=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
