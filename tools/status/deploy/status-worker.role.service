# External Status CPU worker, rendered by tools/status/lib/roles.py. It fetches
# publisher-prepared material over HTTPS, verifies it and activates it locally.
# Private listeners support monitoring and encrypted evaluation. ExecStart,
# the config path and paths are rendered.
[Unit]
Description=Status PIR evaluation worker (external)
After=network-online.target

[Service]
ExecStart=/bin/false
Environment=RAYON_NUM_THREADS=4
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=3
MemoryMax=12G
MemorySwapMax=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
