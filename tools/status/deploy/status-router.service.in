[Unit]
Description=Status PIR CPU packing router and wallet front door
After=network-online.target status-worker.service

[Service]
User=status-pir
Group=status-pir
# Deployment renders and retains the role config; status-router.example.json shows it.
# Its query listener serves the wallet routes `/v1/status/*`.
ExecStart=@RELEASE@/pir-query-server --config /etc/status-pir/router.json
Environment=RAYON_NUM_THREADS=4
# Worker and router prepare serially; one thread let the full-occupancy rebuild
# outlive the 20-second freshness limit. Preparation threads run at nice 10.
Environment=STATUS_PREPARATION_THREADS=6
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=3
MemoryMax=3G
MemorySwapMax=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/status-pir-router-native

[Install]
WantedBy=multi-user.target
