# External Transparent txid display worker, rendered by
# tools/transparent/lib/roles.py. It starts with no publication unless one is
# recorded; the display controller stages, prepares and activates over the
# root-only control socket. ExecStart and paths are rendered.
[Unit]
Description=Transparent txid display worker (external)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/false
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=10
RuntimeDirectory=transparent-display-worker
RuntimeDirectoryMode=0700
LimitNOFILE=1048576
MemoryMax=8G
MemorySwapMax=0
IOWeight=20
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
