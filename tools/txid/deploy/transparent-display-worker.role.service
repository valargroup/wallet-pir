# External Transparent txid display worker, rendered by
# tools/txid/lib/roles.py. It synchronizes combined holdings from its HTTPS
# publisher into its state directory; status is on the loopback management
# listener. ExecStart (`pir-query-server --config
# /etc/transparent-pir/display-worker.json`), that configuration and paths are
# rendered.
[Unit]
Description=Transparent txid display worker (external)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/false
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=10
RuntimeDirectory=transparent-display-worker
RuntimeDirectoryMode=0700
LimitNOFILE=1048576
MemoryMax=8G
MemorySwapMax=0
IOWeight=20
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
