# Rendered by `wallet-pir-deploy.py txid-display-deploy --phase route` (proof of
# concept). The history router imports this file inside both sites through its
# opt-in route_imports hook. Path handles sort by specificity, so archive data
# requests reach the archive owner and every other @TXID@/ request, metadata
# included, reaches the recent replica. A seal changes neither handle.
# The split map (the recent map and its index chunks) is gzipped when the client
# accepts it; the full @TXID@/shards listing is served exactly as before. The
# matcher is scoped to its handle, so a site may render this once per prefix.
	handle @TXID@/archive/* {
		reverse_proxy @ARCHIVE_UPSTREAM@ {
			lb_try_duration 2s
			health_uri /v1/ready
			health_interval 1s
			health_timeout 5s
			fail_duration 10s
			max_fails 3
		}
	}
	handle @TXID@/* {
		@txid_split_map path @TXID@/map @TXID@/map/*
		encode @txid_split_map gzip
		reverse_proxy @RECENT_UPSTREAM@ {
			lb_try_duration 2s
			health_uri /v1/ready
			health_interval 1s
			health_timeout 5s
			fail_duration 10s
			max_fails 3
		}
	}
