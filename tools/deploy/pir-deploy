#!/usr/bin/env bash
# pir-deploy: roll a build release across the fleet by running pirctl on each host.
#
# The inventory (outside the repo, default ~/.config/wallet-pir/inventory) has one
# line per component:
#
#   <ssh destination> <component> <group> [wave]
#
# group is publisher, unified, a product (enhance, status, transparent, txid,
# receiver) or monitoring (APM and pir-monitor, deployed with `product monitoring`). Lines with the same wave restart together; waves run in ascending order
# (default 1), so a product's workers can restart before its router. The publisher's
# host is the coordinator. It holds the deploy lease, the APM alert window, which pauses
# alerts for 10 minutes (an hour with --cold) or until the deploy ends, and the
# production lock that tools/scripts/wallet-pir-deploy.py takes: a deploy holds that
# lock until it ends and refuses to start while a Transparent schema transaction is
# unfinished, so a binary rollout and a Python operation never run at once.
#
# Usage:
#   pir-deploy publisher <sha>                    the shared publisher only
#   pir-deploy product <group> <sha> [--breaking] one product's query roles
#                                                 (--breaking also rolls the publisher
#                                                 and unified nodes first)
#   pir-deploy unified <sha>                      unified query nodes only
#   pir-deploy all <sha>                          publisher, then every query role
#   pir-deploy rollback <group|destination>       swap back to each component's previous release
#   pir-deploy status
#   pir-deploy self-update <sha>                  install that build's pirctl on every host
#                                                 (run before deploying it; restarts nothing)
#
# Options (before the mode): --cold allows a first start of up to an hour.
# --dry-run checks the mode without taking the lease or restarting anything: every
# selected host unpacks the build, its binary accepts the host's config, and the
# build's probe passes against the service running now; then it prints the waves.
# Every deploy and dry run ends with one probe per product through the public origins
# wallets use, run from the publisher's host (PIR_PUBLIC: "<origin>=<products> ...").
# Environment: PIR_INVENTORY, PIR_SSH_CONFIG, PIR_SSH (default ssh), PIR_DISCOVERY,
# PIR_RELEASES, PIR_PUBLIC, PIR_OWNER (the lease and lock holder's name; default
# user@host-pid).
set -euo pipefail

INVENTORY=${PIR_INVENTORY:-$HOME/.config/wallet-pir/inventory}
DISCOVERY=${PIR_DISCOVERY:-https://enhance-pir.valargroup.dev/.well-known/pir-service-discovery}
RELEASES=${PIR_RELEASES:-https://github.com/valargroup/wallet-pir/releases/download}
PUBLIC=${PIR_PUBLIC-https://enhance-pir.valargroup.dev=enhance,status https://transparent-pir.valargroup.dev=transparent_history,transaction_details https://receiver-pir.valargroup.dev=receiver}
SSH=${PIR_SSH:-ssh}
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=10)
[ -n "${PIR_SSH_CONFIG:-}" ] && SSH_OPTS=(-F "$PIR_SSH_CONFIG" "${SSH_OPTS[@]}")
# The production lock's session shares no connection, so it ends with this script, and
# its keepalives end it if the network drops.
HOLD_OPTS=("${SSH_OPTS[@]}" -o ControlMaster=no -o ControlPath=none -o ServerAliveInterval=15 -o ServerAliveCountMax=4)
SSH_OPTS+=(-o ControlMaster=auto -o "ControlPath=/tmp/pir-%C" -o ControlPersist=120)
# The unfinished-schema check wallet-pir-deploy.py makes, run on the coordinator.
FENCE=$(cd "$(dirname "$0")/.." && pwd)/lib/wallet_pir_ops/schema_fence.py
OWNER=${PIR_OWNER:-"$(whoami)@$(hostname -s)-$$"}
DEPLOY_ID="deploy-$(date +%s)-$$"
COLD=
DRY=
HOLD_PID=
WINDOW=
START=$(date +%s)

die() { echo "pir-deploy: $*" >&2; exit 1; }
usage() { sed -n '/^# Usage:/,/^set /p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 2; }

[ -f "$INVENTORY" ] || die "missing inventory $INVENTORY"
# Inventory lines as "destination component group wave".
ENTRIES=$(awk '!/^[[:space:]]*(#|$)/ {print $1, $2, $3, ($4 == "" ? 1 : $4)}' "$INVENTORY")
CONTROL=$(awk '$3 == "publisher" {print $1; exit}' <<<"$ENTRIES")

remote() { local host=$1; shift; "$SSH" "${SSH_OPTS[@]}" "$host" pirctl "$@"; }

select_groups() { awk -v groups=" $* " 'index(groups, " " $3 " ")' <<<"$ENTRIES"; }

# Runs one pirctl command on every given entry; prints the entries that failed. Hosts
# run at once, but one host's components run in turn because pirctl locks the host.
run() {
  local command=$1 entries=$2 extra=${3:-} failed host component pids=()
  [ -n "$entries" ] || return 0
  failed=$(mktemp)
  for host in $(awk '!seen[$1]++ {print $1}' <<<"$entries"); do
    (
      for component in $(awk -v h="$host" '$1 == h {print $2}' <<<"$entries"); do
        # shellcheck disable=SC2086
        remote "$host" "$command" "$component" $extra </dev/null 2>&1 | sed "s|^|[$host $component] |" >&2
        [ "${PIPESTATUS[0]}" = 0 ] || echo "$host $component" >>"$failed"
      done
    ) &
    pids+=($!)
  done
  wait "${pids[@]}" || true
  cat "$failed"
  rm -f "$failed"
}

# Prepares everything first, then restarts wave by wave; a failed wave rolls back
# the components of that wave that had already moved and stops the deploy.
roll() {
  local sha=$1 groups=$2 entries waves wave members failed ok t
  entries=$(select_groups $groups)
  [ -n "$entries" ] || die "the inventory has no $groups components"
  t=$(date +%s)
  if [ -n "$DRY" ]; then
    failed=$(run check "$entries" "$sha")
    [ -z "$failed" ] || die "check failed on: $(tr '\n' ' ' <<<"$failed")"
    echo "== checked $(wc -l <<<"$entries" | tr -d ' ') components in $(($(date +%s) - t))s"
  else
    failed=$(run prepare "$entries" "$sha")
    [ -z "$failed" ] || die "prepare failed on: $(tr '\n' ' ' <<<"$failed")"
    echo "== prepared $(wc -l <<<"$entries" | tr -d ' ') components in $(($(date +%s) - t))s"
  fi
  waves=$(awk '{print $4}' <<<"$entries" | sort -un)
  for wave in $waves; do
    members=$(awk -v w="$wave" '$4 == w' <<<"$entries")
    if [ -n "$DRY" ]; then
      echo "== wave $wave ($groups) would restart: $(awk '{printf "%s%s %s", (NR > 1 ? ", " : ""), $1, $2}' <<<"$members")"
      continue
    fi
    t=$(date +%s)
    held
    failed=$(run deploy "$members" "$sha $COLD")
    if [ -n "$failed" ]; then
      ok=$(awk 'NR == FNR {bad[$1 " " $2]; next} !(($1 " " $2) in bad)' <(printf '%s' "$failed") <(printf '%s\n' "$members"))
      [ -z "$ok" ] || run rollback "$ok" >/dev/null || true
      die "wave $wave failed on: $(tr '\n' ' ' <<<"$failed")"
    fi
    echo "== wave $wave ($groups) deployed in $(($(date +%s) - t))s"
  done
}

# Refuses a partial deploy whose contract major differs from the live publisher's.
contract_guard() {
  local sha=$1 release live
  release=$(curl -fsSL --max-time 20 "$RELEASES/build-${sha:0:12}/contract.json") ||
    die "build-${sha:0:12} has no contract.json; is the release published?"
  live=$(curl -fsSL --max-time 10 "$DISCOVERY" | python3 -c 'import json,sys; print(json.load(sys.stdin)["version"].split(".")[0])')
  python3 -c 'import json, sys
release = json.load(sys.stdin)
sys.exit(0 if all(str(part["contract_major"]) == sys.argv[1] for part in release.values()) else 1)' "$live" <<<"$release" ||
    die "build-${sha:0:12} changes the contract major (live $live); use 'all' or 'product --breaking'"
}

# Takes the coordinator's production lock over an SSH session that lasts until this
# script ends. The session's input stays open while the log file exists and this
# script runs; release() removes the file, and if this script dies the input ends
# within a second anyway, so the lock never outlives the deploy.
hold() {
  HOLD_LOG=$(mktemp)
  "$SSH" "${HOLD_OPTS[@]}" "$CONTROL" pirctl hold "$OWNER" \
    < <(while [ -e "$HOLD_LOG" ] && kill -0 $$; do sleep 0.2; done 2>/dev/null) >"$HOLD_LOG" 2>&1 &
  HOLD_PID=$!
  until grep -qx locked "$HOLD_LOG"; do
    if ! kill -0 "$HOLD_PID" 2>/dev/null; then
      sed "s|^|[$CONTROL production lock] |" "$HOLD_LOG" >&2
      die "could not take the production lock on $CONTROL"
    fi
    sleep 0.2
  done
}

# Stops before the next restart if the lock's session has ended.
held() {
  [ -z "$HOLD_PID" ] || kill -0 "$HOLD_PID" 2>/dev/null ||
    die "lost the production lock on $CONTROL: its SSH session ended"
}

# Ends the lock's session and waits up to 10 s for the coordinator to release it.
release() {
  local i
  [ -n "$HOLD_PID" ] || return 0
  rm -f "$HOLD_LOG"
  for ((i = 0; i < 50; i++)); do kill -0 "$HOLD_PID" 2>/dev/null || break; sleep 0.2; done
  kill "$HOLD_PID" 2>/dev/null || true
  wait "$HOLD_PID" 2>/dev/null || true
}

# Refuses while a Transparent schema transaction, host action or input staging that
# wallet-pir-deploy.py started is unfinished.
fence() {
  [ -f "$FENCE" ] || die "missing $FENCE; run pir-deploy from a wallet-pir checkout"
  remote "$CONTROL" fence <"$FENCE" 2>&1 | sed "s|^|[$CONTROL] |" >&2 ||
    die "an unfinished operation fences the fleet; reconcile it with wallet-pir-deploy.py first"
}

begin() {
  [ -n "$CONTROL" ] || die "the inventory has no publisher line to hold the lease"
  if [ -n "$DRY" ]; then
    trap 'dry_finish $?' EXIT
    fence
    return
  fi
  remote "$CONTROL" lease take "$OWNER" "$([ -n "$COLD" ] && echo 4200 || echo 1200)" || exit 1
  trap 'finish $?' EXIT
  hold
  fence
  WINDOW=1
  remote "$CONTROL" alerts begin "$DEPLOY_ID" --seconds "$([ -n "$COLD" ] && echo 3600 || echo 600)" "$@" || echo "pir-deploy: alerts stay armed (APM refused the window)" >&2
}

# Probes every product through its public origin, all at once.
public_probe() {
  local sha=${1:-} t pair pids=() failed=0
  [ -n "$PUBLIC" ] || return 0
  t=$(date +%s)
  for pair in $PUBLIC; do
    remote "$CONTROL" public "${pair%%=*}" "${pair#*=}" $sha </dev/null 2>&1 | sed "s|^|[public] |" >&2 &
    pids+=($!)
  done
  for pid in "${pids[@]}"; do wait "$pid" || failed=1; done
  [ "$failed" = 0 ] || die "a public probe failed"
  echo "== public probes passed in $(($(date +%s) - t))s"
}

dry_finish() {
  echo "== dry run $([ "$1" = 0 ] && echo passed || echo FAILED) in $(($(date +%s) - START))s"
}

finish() {
  local code=$1
  local outcome=() result='done'
  [ "$code" = 0 ] || outcome=(--failed) result=FAILED
  [ -z "$WINDOW" ] || remote "$CONTROL" alerts finish "$DEPLOY_ID" "${outcome[@]}" >/dev/null 2>&1 || true
  release
  remote "$CONTROL" lease drop "$OWNER" >/dev/null 2>&1 || true
  echo "== $result in $(($(date +%s) - START))s"
}

while :; do
  case ${1:-} in
    --cold) COLD=--cold; shift ;;
    --dry-run) DRY=1; shift ;;
    *) break ;;
  esac
done
mode=${1:-}
case $mode in
  publisher|unified|all)
    [ $# -eq 2 ] || usage
    sha=$2
    [ "$mode" = all ] || contract_guard "$sha"
    begin "$mode"
    case $mode in
      publisher) roll "$sha" publisher ;;
      unified) roll "$sha" unified ;;
      all)
        roll "$sha" publisher
        roll "$sha" "$(awk '$3 != "publisher" {print $3}' <<<"$ENTRIES" | sort -u | paste -sd' ' -)" ;;
    esac ;;
  product)
    [ $# -ge 3 ] || usage
    group=$2 sha=$3
    if [ "${4:-}" = --breaking ]; then
      begin publisher unified "$group"
      roll "$sha" publisher
      roll "$sha" "unified $group"
    else
      contract_guard "$sha"
      begin "$group"
      roll "$sha" "$group"
    fi ;;
  rollback)
    [ $# -eq 2 ] || usage
    entries=$(awk -v t="$2" '$1 == t || $3 == t' <<<"$ENTRIES")
    [ -n "$entries" ] || die "no inventory line matches $2"
    [ -z "$DRY" ] || { echo "== would roll back: $(awk '{printf "%s%s %s", (NR > 1 ? ", " : ""), $1, $2}' <<<"$entries")"; exit 0; }
    begin rollback
    held
    failed=$(run rollback "$entries")
    [ -z "$failed" ] || die "rollback failed on: $(tr '\n' ' ' <<<"$failed")" ;;
  status)
    failed=$(mktemp)
    for host in $(awk '{print $1}' <<<"$ENTRIES" | sort -u); do
      { remote "$host" status </dev/null 2>&1 || echo "$host" >>"$failed"; } | sed "s|^|[$host] |" &
    done
    wait
    bad=$(paste -sd' ' - <"$failed")
    rm -f "$failed"
    [ -z "$bad" ] || die "status failed on: $bad" ;;
  self-update)
    [ $# -eq 2 ] || usage
    hosts=$(awk '{print $1}' <<<"$ENTRIES" | sort -u)
    [ -z "$DRY" ] || { echo "== would update pirctl on: $(paste -sd' ' - <<<"$hosts")"; exit 0; }
    failed=$(mktemp)
    for host in $hosts; do
      { remote "$host" self-update "$2" </dev/null 2>&1 || echo "$host" >>"$failed"; } | sed "s|^|[$host] |" &
    done
    wait
    bad=$(paste -sd' ' - <"$failed")
    rm -f "$failed"
    [ -z "$bad" ] || die "pirctl update failed on: $bad"
    echo "== pirctl at build-${2:0:12} on $(wc -l <<<"$hosts" | tr -d ' ') hosts in $(($(date +%s) - START))s" ;;
  *) usage ;;
esac
# Reading status or updating pirctl moves no release, so it probes nothing.
case $mode in status | self-update) ;; *) public_probe "${sha:-}" ;; esac
