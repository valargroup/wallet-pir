[Unit]
Description=Receiver in the root query server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/bin/false
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=15
KillMode=mixed
TimeoutStopSec=60
MemoryHigh=6G
MemoryMax=7G
MemorySwapMax=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
