# External Receiver worker: serves the publication an operator-owned record
# names (`receiver-directory serve-publication`). Rendered by
# tools/receiver/lib/roles.py: ExecStart, ReadWritePaths, ReadOnlyPaths and any
# inventory budgets or credential files are replaced; everything else here is
# the sandbox. No address, node or provider credential is a default.
[Unit]
Description=Receiver PIR serving operator-staged publications
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/bin/false
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=15
KillMode=mixed
TimeoutStopSec=60
MemoryHigh=6G
MemoryMax=7G
MemorySwapMax=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
