{
	servers {
		# The unified wallet host (`wallet-pir.valargroup.dev`, on the shared
		# coordinator at `wallet_pir_coordinator_dns_ipv4`) forwards Receiver
		# requests here. Trust only that address to append to X-Forwarded-For, so
		# the service's per-client admission keys on the wallet that sent the
		# request rather than on the coordinator. Every other peer's header is
		# replaced with its own address, as before.
		trusted_proxies static 167.99.42.60/32
	}
}

receiver-pir.valargroup.dev {
	# The service refuses a query that is not exactly its fixed length, and caps the
	# upload before that; this is the outer bound.
	request_body {
		max_size 2MB
	}

	# Only the wallet-facing routes, at the canonical `/receiver/v1/` prefix and the
	# deployed `/v1/receiver/` one. `/v1/receiver/health` and `/metrics` are
	# deliberately not here. Publisher health stays on the shared publisher's
	# private management listener; this edge forwards only public discovery.
	@wallet path /receiver/v1/inventory /receiver/v1/inventory/* /receiver/v1/query /receiver/v1/public/* /receiver/v1/shard-filters/* /receiver/v1/choice/* /receiver/v1/block-filters/* /v1/receiver/inventory /v1/receiver/inventory/* /v1/receiver/query /v1/receiver/public/* /v1/receiver/shard-filters/* /v1/receiver/choice/* /v1/receiver/block-filters/*
	handle @wallet {
		reverse_proxy {$RECEIVER_QUERY_UPSTREAM} {
			header_up Host {upstream_hostport}
		}
	}

	# Both upstreams are existing HTTPS origins. The shared publisher serves
	# prepared inputs; the query host serves wallet requests.
	@provider path /provider/receiver/v1/*
	handle @provider {
		reverse_proxy {$RECEIVER_PUBLISHER_UPSTREAM} {
			header_up Host {upstream_hostport}
		}
	}

	handle /.well-known/pir-service-discovery {
		reverse_proxy {$RECEIVER_PUBLISHER_UPSTREAM} {
			header_up Host {upstream_hostport}
		}
	}

	handle {
		respond 404
	}
}
