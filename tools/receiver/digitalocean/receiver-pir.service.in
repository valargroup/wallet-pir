[Unit]
Description=Receiver ingestion in the root publisher
After=network-online.target
Wants=network-online.target
[Service]
User=receiver-pir
Group=receiver-pir
# NEAR_INTENTS_EXPLORER=<partner key> for the optional payout audit, from the
# inventory's NEAR_KEY id. Without the file the service indexes and serves
# without the audit. near-key.py installs these; see README.md.
EnvironmentFile=-/etc/receiver-pir/near-@NEAR_KEY@.env
# Configuration and writable paths are supplied by the root role renderer.
ExecStart=/bin/false
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=15
KillMode=mixed
TimeoutStopSec=60
MemoryHigh=6G
MemoryMax=7G
MemorySwapMax=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/receiver-pir
[Install]
WantedBy=multi-user.target
